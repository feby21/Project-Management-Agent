if(prop("Status") == "Completed", 0, let(d, if(empty(prop("Deadline")), 999, dateBetween(prop("Deadline"), today(), "days")), urgency, ifs(d <= 3, 5, d <= 7, 4, d <= 14, 3, d <= 30, 2, 1), imp, ifs(prop("Importance") == "Critical", 5, prop("Importance") == "High", 4, prop("Importance") == "Medium", 3, prop("Importance") == "Low", 2, 1), strat, ifs(prop("Strategic Value") == "Critical", 5, prop("Strategic Value") == "High", 4, prop("Strategic Value") == "Medium", 3, prop("Strategic Value") == "Low", 2, 1), risk, ifs(empty(prop("Progress")), 5, prop("Progress") < 0.25, 5, prop("Progress") < 0.5, 4, prop("Progress") < 0.75, 3, prop("Progress") < 0.9, 2, 1), idle, if(empty(prop("Last Worked On")), 15, dateBetween(today(), prop("Last Worked On"), "days")), neglect, ifs(idle > 14, 5, idle > 7, 4, idle > 3, 3, idle > 1, 2, 1), round((urgency * 0.30 + imp * 0.25 + strat * 0.20 + risk * 0.15 + neglect * 0.10) * 20)))
